---
// 1. Açılış çizgisi ile kod bloğu başlar.
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
}

const { title = "Wiccasoft" } = Astro.props;
// 2. Kapanış çizgisi ile kod bloğu biter. HTML bundan sonra başlar.
---
<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Değişken olan dinamik başlığı buraya ekledik -->
		<title>{title}</title>
		
		<!-- Sayfa geçiş özelliğini head etiketinin içine taşıdık -->
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		background-color: #0d0d0d;
	}
</style>